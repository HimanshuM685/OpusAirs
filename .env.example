# ==============================================================================
# OpusAirs — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Neon) — REQUIRED
# ------------------------------------------------------------------------------
# Connection string to Neon serverless PostgreSQL database (with SSL enabled).
# Tables, route baskets, benchmarks, and scraper sources auto-seed into DB on boot.
# Example: postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Auth (users table) + admin seed
# ------------------------------------------------------------------------------
# Public register/login uses the users table. Passwords are scrypt-hashed.
# First admin is seeded on boot if none exists.
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=change_this_to_a_secure_password
SESSION_SECRET=change_this_long_random_string

# ------------------------------------------------------------------------------
# 3. Data & Index Computation Settings
# ------------------------------------------------------------------------------
# Base date for APIx index calculation (reference window where index = 100)
# Format: YYYY-MM-DD (Defaults to 2026-08-01)
APIX_BASE_DATE=2026-08-01

# ------------------------------------------------------------------------------
# 4. Scraper Engine Configuration
# ------------------------------------------------------------------------------
# Enable or disable automated scraper runs during collection pipeline
SCRAPE_ENABLED=false

# User-Agent header passed when fetching robots.txt and airline search portals
USER_AGENT=OpusAirs-APIx-Research/1.0 (+https://mospi.gov.in)

# Politeness rate limit delay (in seconds) between individual portal scrape requests
LIVE_RATE_LIMIT_SECONDS=8

# ------------------------------------------------------------------------------
# 6. Optional LLM for natural-language fare dumps (/admin/ingest)
# ------------------------------------------------------------------------------
# Prose dumps on /admin/ingest. JSON/CSV work with neither key.
# OpenRouter used when OPENROUTER_API_KEY is set (or GROQ_MODEL looks like org/model).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ------------------------------------------------------------------------------
# 5. Application Server
# ------------------------------------------------------------------------------
PORT=3000

