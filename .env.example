# ==============================================================================
# OpusAirs — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Neon) — REQUIRED
# ------------------------------------------------------------------------------
# Connection string to Neon serverless PostgreSQL database (with SSL enabled).
# Tables, route baskets, benchmarks, and scraper sources auto-seed into DB on boot.
# Example: postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Auth (users table) + admin seed
# ------------------------------------------------------------------------------
# Public register/login uses the users table. Passwords are scrypt-hashed.
# /admin accepts only these two values. If either is empty, admin login and admin APIs stay closed.
# There is no default password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=change_this_long_random_string

# ------------------------------------------------------------------------------
# 3. Data & Index Computation Settings
# ------------------------------------------------------------------------------
# Base date for APIx index calculation (reference window where index = 100)
# Format: YYYY-MM-DD (Defaults to 2026-08-01)
APIX_BASE_DATE=2026-08-01

# ------------------------------------------------------------------------------
# 4. Scraper Engine Configuration
# ------------------------------------------------------------------------------
# Enable or disable automated scraper runs during collection pipeline
SCRAPE_ENABLED=false

# Optional key for ingest, collect, and rebuild. Admin cookie still works if this is empty.
INGEST_API_KEY=
# Illustrative CPI weight for the air component. Not an official MoSPI weight.
CPI_AIR_WEIGHT=0.004
MAPE_TARGET=0.08
SNAPSHOT_HOURS=6,18

# Real bot identity used in every robots and fare request. Replace with your domain/contact.
BOT_DOMAIN=your-domain.example
BOT_CONTACT=contact@your-domain.example

# Politeness rate limit delay (in seconds) between individual portal scrape requests
COLLECT_MAX_RPM_PER_HOST=8
COLLECT_JITTER_MS=3000-8000
COLLECT_MAX_CONCURRENT_HOSTS=3

# Offline judging only. POST collect/run with {"demo":true} to include synthetic data.
# Synthetic quotes are tagged source=synthetic and produce demo vintage, not official indices.
SYNTHETIC_DEMO_ENABLED=false

# Daily crawl stops after this many hours and resumes on the next run
COLLECT_MAX_HOURS=18

# Optional POST target when a source is blocked on more than half its attempts
ALERT_WEBHOOK=

# ------------------------------------------------------------------------------
# 6. Optional LLM for natural-language fare dumps (/admin/ingest)
# ------------------------------------------------------------------------------
# Prose dumps on /admin/ingest. JSON/CSV work without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. Application Server
# ------------------------------------------------------------------------------
PORT=3000
