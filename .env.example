# ==============================================================================
# OpusAirs — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Neon) — REQUIRED
# ------------------------------------------------------------------------------
# Connection string to Neon serverless PostgreSQL database (with SSL enabled).
# Tables, route baskets, benchmarks, and scraper sources auto-seed into DB on boot.
# Example: postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Neon Auth (Managed Better Auth) — Public Login & Google-only Admin
# ------------------------------------------------------------------------------
# Managed Better Auth URL configured in your Neon Console (Project -> Branch -> Auth).
# Example: https://ep-xxxxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=https://ep-xxxxx.neonauth.region.aws.neon.tech/neondb/auth

# Secret used to encrypt and verify session cookies (minimum 32 characters)
NEON_AUTH_COOKIE_SECRET=change_this_to_at_least_32_characters_secret_string

# Comma-separated list of Google accounts authorized to access the /admin panel.
# Public: Google (recommended) or email/password. Admin: verified Google sign-in only.
# Enable Google and email/password in Neon Console; add local/production trusted origins.
# Empty ADMIN_EMAILS denies all operator access. No seeded admin password is used.
ADMIN_EMAILS=admin@example.com

# ------------------------------------------------------------------------------
# 3. Data & Index Computation Settings
# ------------------------------------------------------------------------------
# Base date for APIx index calculation (reference window where index = 100)
# Format: YYYY-MM-DD (Defaults to 2026-08-01)
APIX_BASE_DATE=2026-08-01

# ------------------------------------------------------------------------------
# 4. Scraper Engine Configuration
# ------------------------------------------------------------------------------
# Enable or disable automated scraper runs during collection pipeline
SCRAPE_ENABLED=false

# Optional key for ingest, collect, and rebuild. Authorized Google admin sessions also work.
INGEST_API_KEY=
# Illustrative CPI weight for the air component. Not an official MoSPI weight.
CPI_AIR_WEIGHT=0.004
MAPE_TARGET=0.08
SNAPSHOT_HOURS=6

# Real bot identity used in every robots and fare request. Replace with your domain/contact.
BOT_DOMAIN=your-domain.example
BOT_CONTACT=contact@your-domain.example

# Politeness rate limit delay (in seconds) between individual portal scrape requests
COLLECT_MAX_RPM_PER_HOST=8
COLLECT_JITTER_MS=3000-8000
COLLECT_MAX_CONCURRENT_HOSTS=3

# Offline judging only. POST collect/run with {"demo":true} to include synthetic data.
# Synthetic quotes are tagged source=synthetic and produce demo vintage, not official indices.
SYNTHETIC_DEMO_ENABLED=false

# Daily crawl stops after this many hours and resumes on the next run
COLLECT_MAX_HOURS=3

# Tinyfish is worker-only transport, never a robots/challenge bypass.
TINYFISH_ENABLED=false
TINYFISH_API_KEY=
TINYFISH_COUNTRY=IN
TINYFISH_MAX_SESSIONS_PER_RUN=5
TINYFISH_MAX_AGENT_RUNS_PER_RUN=5
TINYFISH_SESSION_TIMEOUT_S=900

# Weekly Sunday 02:00 IST discovery normally reads data/drops/schedule.csv only.
DISCOVER_WITH_BROWSER=false
# Optional permitted public timetable/route-map paths; no guessed URLs or OTA pagination.
DISCOVER_AIRINDIA_PATH=
DISCOVER_AIRINDIA_EXPRESS_PATH=
DISCOVER_AKASA_PATH=
DISCOVER_SPICEJET_PATH=

# Optional POST target if observed coverage < 0.80 or any airline is blocked
ALERT_WEBHOOK=

# ------------------------------------------------------------------------------
# 6. Optional LLM for natural-language fare dumps (/admin/ingest)
# ------------------------------------------------------------------------------
# Prose dumps on /admin/ingest. JSON/CSV work without a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. Application Server
# ------------------------------------------------------------------------------
PORT=3000
